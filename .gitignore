# Obsidian UI state (churn, merge conflicts)
.obsidian/workspace*
.obsidian/cache
.obsidian/plugins/
.obsidian/community-plugins.json
.obsidian/plugins/*/data.json.bak

# Private portfolio data (per D-03: local-only, never committed)
notes/private/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
dist/
build/

# Database (NEVER commit)
data/pg/

# Ollama cache
.ollama/

# graphify outputs (regeneratable)
graphify-out/
.graphify_detect.json
.graphify_python

# Secrets
.env
.env.local
.env.*.local

# Raw collected data caches
raw_cache/

# Local-only collected market data (vault/raw is collector output —
# kept on each operator's machine, not shared via git per D-03 stance).
vault/raw/

# Machine-generated pipeline state (heartbeat updated by collectors/ingest)
ingested/_status/

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
