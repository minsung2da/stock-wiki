# Obsidian UI state (churn, merge conflicts)
.obsidian/workspace*
.obsidian/cache
.obsidian/plugins/
.obsidian/community-plugins.json
.obsidian/plugins/*/data.json.bak

# Phase 8 D-16/D-17: commit Dataview plugin bootstrap (settings, not state)
!.obsidian/community-plugins.json
!.obsidian/plugins/
!.obsidian/plugins/dataview/
!.obsidian/plugins/dataview/data.json

# Private portfolio data (per D-03: local-only, never committed)
notes/private/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
dist/
build/

# Database (NEVER commit)
data/pg/

# Ollama cache
.ollama/

# graphify outputs (regeneratable)
graphify-out/
.graphify_detect.json
.graphify_python

# Phase 7 graph snapshots — regenerable, never commit
# Use file-level glob (not dir-level) so the README.md exception below works.
vault/graph/*
!vault/graph/README.md
vault/.graphify-staging/

# Secrets
.env
.env.local
.env.*.local

# Raw collected data caches
raw_cache/

# Phase 8 GAP-08: repo-root `ingested/` is legacy.
# Production heartbeat lives at vault/ingested/_status/heartbeat.md (vault_root scoped).
# Block the entire repo-root directory so it can't recreate as a stray sink.
ingested/

# Belt-and-suspenders: keep binary/dump artifacts out of vault/raw even if
# something writes there by mistake. vault/raw/**.md (text) is the vault's
# committed source of truth (PROJECT.md §9.2). Binaries belong in raw/ or
# raw_cache/ which are already gitignored above.
vault/raw/**/*.html
vault/raw/**/*.htm
vault/raw/**/*.pdf
vault/raw/**/*.json
vault/raw/**/*.gz
vault/raw/**/*.zip
vault/raw/**/*.png
vault/raw/**/*.jpg
vault/raw/**/*.jpeg

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Phase 8 — derived dashboard cache (regeneratable from DB)
dashboards/_data/

# IDE
.vscode/
.idea/
*.swp
*.swo
