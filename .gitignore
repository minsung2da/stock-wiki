# Obsidian UI state (churn, merge conflicts)
.obsidian/workspace*
.obsidian/cache
.obsidian/plugins/
.obsidian/community-plugins.json
.obsidian/plugins/*/data.json.bak

# Private portfolio data (per D-03: local-only, never committed)
notes/private/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
dist/
build/

# Database (NEVER commit)
data/pg/

# Ollama cache
.ollama/

# graphify outputs (regeneratable)
graphify-out/
.graphify_detect.json
.graphify_python

# Phase 7 graph snapshots — regenerable, never commit
# Use file-level glob (not dir-level) so the README.md exception below works.
vault/graph/*
!vault/graph/README.md
vault/.graphify-staging/

# Secrets
.env
.env.local
.env.*.local

# Raw collected data caches
raw_cache/

# Machine-generated pipeline state (heartbeat updated by collectors/ingest)
ingested/_status/

# Belt-and-suspenders: keep binary/dump artifacts out of vault/raw even if
# something writes there by mistake. vault/raw/**.md (text) is the vault's
# committed source of truth (PROJECT.md §9.2). Binaries belong in raw/ or
# raw_cache/ which are already gitignored above.
vault/raw/**/*.html
vault/raw/**/*.htm
vault/raw/**/*.pdf
vault/raw/**/*.json
vault/raw/**/*.gz
vault/raw/**/*.zip
vault/raw/**/*.png
vault/raw/**/*.jpg
vault/raw/**/*.jpeg

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
