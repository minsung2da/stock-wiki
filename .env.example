# .env.example -- copy to .env and fill in real values
# NEVER commit .env to git

# DART API (from opendart.fss.or.kr)
OPEN_DART_API_KEY=your_40_hex_char_key_here
DART_API_KEY=your-key-here  # register free at opendart.fss.or.kr

# Database
POSTGRES_PASSWORD=your_postgres_password_here
DATABASE_URL=postgresql+psycopg://stockwiki:${POSTGRES_PASSWORD}@127.0.0.1:5432/stockwiki

# FRED API (from fred.stlouisfed.org)
FRED_API_KEY=your_fred_api_key_here

# ECOS API (from ecos.bok.or.kr)
ECOS_API_KEY=your_ecos_api_key_here

# Ingest extraction: handled by Claude Schedule agent (git round-trip),
# not a local Ollama server. No OLLAMA_HOST / OLLAMA_MODEL keys are needed.
# Embeddings run in-process via sentence-transformers (BAAI/bge-m3).

# Cloud LLM fallback (only for MCP server, NEVER for ingest)
# ANTHROPIC_API_KEY=sk-ant-...
# ALLOW_CLOUD_LLM=0
# MAX_CLOUD_USD=0.50
